<UserControl x:Class="BoundlessStudy.Desktop.Views.FocusSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BoundlessStudy.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FocusSetupViewModel}"
             AutomationProperties.Name="Focus Session Setup View"
             AutomationProperties.HelpText="Configure focus profile, planned session duration, and optional study task."
             AutomationProperties.AutomationId="FocusSetupView"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="680" HorizontalAlignment="Left">

            <!-- Title & Description -->
            <TextBlock Text="Start a Focus Session"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>
            <TextBlock Text="Select a focus profile, set your planned study duration, and optionally link a task to begin protected study."
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <!-- Interrupted Session BLOCKING Alert Banner (Live Region) -->
            <Border x:Name="RecoveryBlockBanner"
                    AutomationProperties.Name="Pending Recovery Blocking Alert"
                    AutomationProperties.LiveSetting="Assertive"
                    Visibility="{Binding HasPendingRecoverableSession, Converter={StaticResource BoolToVisibility}}"
                    Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    Padding="16"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="New Session Blocked: Pending Interrupted Session"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding RecoverableSessionWarning}"
                               Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <Button x:Name="ResolveInterruptedButton"
                            AutomationProperties.Name="Resolve Interrupted Session"
                            AutomationProperties.HelpText="Opens the recovery dialog to resolve the interrupted session."
                            Content="_Resolve Interrupted Session"
                            Command="{Binding ResolveRecoveryCommand}"
                            HorizontalAlignment="Left"
                            Padding="14,6"/>
                </StackPanel>
            </Border>

            <!-- Error Banner -->
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Configuration Form -->
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    BorderThickness="1"
                    Padding="20"
                    Margin="0,0,0,20">
                <StackPanel>

                    <!-- 1. Focus Profile Selection -->
                    <TextBlock x:Name="ProfileFieldLabel"
                               Text="Focus Profile:"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="ProfileComboBox"
                              AutomationProperties.Name="Focus Profile Selection"
                              AutomationProperties.HelpText="Choose the focus profile governing distraction blocking and XP rates."
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="DisplayName"
                              MinWidth="280"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding SelectedProfileDescription}"
                               FontStyle="Italic"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Margin="0,0,0,16"/>

                    <!-- 2. Duration Selection -->
                    <TextBlock x:Name="DurationFieldLabel"
                               Text="Planned Duration (Minutes):"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="DurationComboBox"
                              AutomationProperties.Name="Focus Duration Selection"
                              AutomationProperties.HelpText="Select the planned session duration in minutes."
                              ItemsSource="{Binding AvailableDurations}"
                              SelectedItem="{Binding SelectedDurationMinutes}"
                              MinWidth="160"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,16"/>

                    <!-- 3. Optional Task Selection -->
                    <TextBlock x:Name="TaskFieldLabel"
                               Text="Linked Study Task (Optional):"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="TaskComboBox"
                              AutomationProperties.Name="Linked Study Task Selection"
                              AutomationProperties.HelpText="Optionally link an active study task to track completion."
                              ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask}"
                              DisplayMemberPath="Title"
                              MinWidth="340"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,8"/>
                    <TextBlock Text="Linking a task records study time against the task and allows automatic completion upon session success."
                               FontSize="11"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Margin="0,0,0,16"/>

                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <WrapPanel HorizontalAlignment="Left" Margin="0,0,0,16">
                <Button x:Name="StartSessionButton"
                        AutomationProperties.Name="Start Focus Session"
                        AutomationProperties.HelpText="Begins the focus session with active protection rules."
                        Content="_Start Focus Session"
                        Command="{Binding StartSessionCommand}"
                        MinWidth="170"
                        MinHeight="38"
                        Margin="0,0,12,6"/>

                <Button x:Name="BackButton"
                        AutomationProperties.Name="Back to Home"
                        AutomationProperties.HelpText="Returns to the home dashboard without starting a session."
                        Content="_Back to Home"
                        Command="{Binding CancelCommand}"
                        MinWidth="120"
                        MinHeight="38"
                        Margin="0,0,12,6"/>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
