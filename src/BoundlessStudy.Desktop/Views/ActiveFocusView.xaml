<UserControl x:Class="BoundlessStudy.Desktop.Views.ActiveFocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BoundlessStudy.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ActiveFocusViewModel}"
             AutomationProperties.Name="Active Focus Session View"
             AutomationProperties.HelpText="Active study timer with real-time focus tracking and session completion controls."
             AutomationProperties.AutomationId="ActiveFocusView"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">

            <!-- ========================================================================= -->
            <!-- Ongoing Session View (Visible while running)                              -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">

                <!-- Header & Status -->
                <TextBlock Text="Active Focus Session"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding StateDisplay}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                           Margin="0,0,0,16"/>

                <!-- Main Timer Card -->
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                        BorderThickness="2"
                        Padding="24"
                        Margin="0,0,0,20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Time Remaining"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding RemainingDisplay}"
                                   HorizontalAlignment="Center"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   Margin="0,0,0,16"/>

                        <!-- Progress Bar -->
                        <ProgressBar x:Name="SessionProgressBar"
                                     AutomationProperties.Name="Focus Session Progress"
                                     AutomationProperties.HelpText="Visual progress of elapsed focus time against planned duration."
                                     Value="{Binding ProgressPercent}"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="12"
                                     MinWidth="400"
                                     Margin="0,0,0,16"/>

                        <!-- Sub-timers (Elapsed & Active) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Elapsed Time"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                <TextBlock Text="{Binding ElapsedDisplay}"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Margin="24,0,0,0">
                                <TextBlock Text="Active Study Time"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                <TextBlock Text="{Binding ActiveStudyDisplay}"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Session Metadata Card -->
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Profile:" FontWeight="SemiBold" Margin="0,2,0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProfileCode}" Margin="0,2,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Planned Duration:" FontWeight="SemiBold" Margin="0,2,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlannedDurationDisplay}" Margin="0,2,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Linked Task:" FontWeight="SemiBold" Margin="0,2,0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TaskTitleDisplay}" TextWrapping="Wrap" Margin="0,2,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Subject:" FontWeight="SemiBold" Margin="0,2,0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SubjectNameDisplay}" Margin="0,2,0,4"/>
                    </Grid>
                </Border>

                <!-- Controls & Actions -->
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Session Controls"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="0,0,0,12"/>

                        <!-- Complete Session Action -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="CompleteSessionButton"
                                    AutomationProperties.Name="Complete Focus Session"
                                    AutomationProperties.HelpText="Completes the focus session, awards full eligible study XP, and updates streaks."
                                    Content="_Complete Session"
                                    Command="{Binding CompleteCommand}"
                                    MinWidth="160"
                                    MinHeight="36"
                                    Margin="0,0,16,0"/>
                            <TextBlock Text="Complete once planned study time is reached, or finalize current focus."
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </StackPanel>

                        <Separator Margin="0,0,0,16"/>

                        <!-- End Early Action with Reason Selection -->
                        <TextBlock Text="End Session Early:"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="EarlyExitReasonComboBox"
                                      AutomationProperties.Name="Early Exit Reason Selection"
                                      AutomationProperties.HelpText="Select the reason for concluding the session before the planned duration."
                                      ItemsSource="{Binding AvailableEndReasons}"
                                      SelectedItem="{Binding SelectedEndReason}"
                                      MinWidth="200"
                                      Margin="0,0,12,0"/>

                            <Button x:Name="EndEarlyButton"
                                    AutomationProperties.Name="End Focus Early"
                                    AutomationProperties.HelpText="Ends the focus session early with recorded reason and partial XP award."
                                    Content="_End Early"
                                    Command="{Binding EndEarlyCommand}"
                                    MinWidth="120"
                                    MinHeight="36"/>
                        </StackPanel>
                        <TextBlock Text="Ending early awards partial XP (50% rate) and does not qualify for daily streaks."
                                   FontSize="11"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ========================================================================= -->
            <!-- Session Summary Outcome View (Visible after completion or early end)      -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="Session Summary &amp; Rewards"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Here are the results of your completed focus session."
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Margin="0,0,0,16"/>

                <!-- Outcome Card -->
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                        BorderThickness="2"
                        Padding="24"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Session Completed!"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- XP Awarded -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="XP Earned:" FontWeight="Bold" Margin="0,4,0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AwardXpDisplay}" FontWeight="Bold" FontSize="16" Margin="0,4,0,4"/>

                            <!-- Total XP -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Total XP:" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalXpDisplay}" Margin="0,4,0,4"/>

                            <!-- Level Change -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Progression Level:" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LevelChangeDisplay}" FontWeight="SemiBold" Margin="0,4,0,4"/>

                            <!-- Streak Qualification -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Streak Qualification:" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StreakQualifiedDisplay}" Margin="0,4,0,4"/>

                            <!-- Active Study Time Recorded -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Active Time Recorded:" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ActiveStudyDisplay}" Margin="0,4,0,4"/>

                            <!-- Unlocked Achievements -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Achievements Unlocked:" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding UnlockedAchievementsDisplay}" TextWrapping="Wrap" Margin="0,4,0,4"/>
                        </Grid>

                        <Button x:Name="ReturnHomeButton"
                                AutomationProperties.Name="Return to Home"
                                AutomationProperties.HelpText="Returns to the home dashboard overview."
                                Content="_Return to Home"
                                Command="{Binding ReturnHomeCommand}"
                                MinWidth="150"
                                MinHeight="38"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Error Banner -->
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
