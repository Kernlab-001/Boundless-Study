<Window x:Class="BoundlessStudy.Desktop.Views.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:BoundlessStudy.Desktop.Views"
        xmlns:accessibility="clr-namespace:BoundlessStudy.Desktop.Accessibility"
        mc:Ignorable="d"
        Title="Focus Session Recovery"
        AutomationProperties.Name="Focus Session Recovery Dialog"
        AutomationProperties.HelpText="Dialog to review and resume or discard an interrupted focus session."
        AutomationProperties.AutomationId="RecoveryDialog"
        Width="640"
        Height="540"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        accessibility:AccessibilityProperties.EscapeClosesWindow="True"
        KeyboardNavigation.TabNavigation="Cycle"
        KeyboardNavigation.DirectionalNavigation="Cycle"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid>
        <views:RecoveryView x:Name="RecoveryViewContent"
                            AutomationProperties.Name="Focus Session Recovery Content"
                            AutomationProperties.AutomationId="RecoveryViewContent"/>
    </Grid>
</Window>
