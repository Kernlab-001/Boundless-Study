<Window x:Class="BoundlessStudy.Desktop.Views.ApplicationInterventionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boundless Study — Focus restriction"
        Width="800"
        Height="600"
        SizeToContent="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Opacity="0"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Boundless Study application restriction"
        AutomationProperties.HelpText="Visible explanation for an application restriction during a focus session."
        AutomationProperties.AutomationId="ApplicationInterventionOverlay"
        KeyboardNavigation.TabNavigation="Cycle"
        KeyboardNavigation.DirectionalNavigation="Cycle"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
      <Border MinWidth="240"
              MaxWidth="520"
              Margin="16"
              Padding="24"
              BorderThickness="2"
              BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
              Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Focus session restriction"
                       FontSize="22"
                       FontWeight="Bold"
                       AutomationProperties.HeadingLevel="Level1"
                       Margin="0,0,0,16" />
            <TextBlock Text="{Binding ApplicationName}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Restricted application"
                       AutomationProperties.AutomationId="RestrictedApplication"
                       Margin="0,0,0,8" />
            <TextBlock Text="{Binding Reason}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Restriction reason"
                       AutomationProperties.AutomationId="RestrictionReason"
                       Margin="0,0,0,12" />
            <TextBlock Text="{Binding SessionDisplay}"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       AutomationProperties.Name="Active focus session"
                       AutomationProperties.AutomationId="ActiveFocusSession"
                       Margin="0,0,0,8" />
            <TextBlock Text="{Binding EnforcementStatus}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       AutomationProperties.Name="Enforcement status"
                       AutomationProperties.AutomationId="EnforcementStatus"
                       Margin="0,0,0,8" />
            <TextBlock Text="To return to study, switch away from this application. The Agent will resume the session when this restriction is no longer active."
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />
            <Separator Margin="0,0,0,12" />
            <TextBlock Text="Request a temporary exception (subject to your focus profile):"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding ReasonCategories}"
                      SelectedItem="{Binding SelectedReason}"
                      IsEnabled="{Binding CanRequestException}"
                      AutomationProperties.Name="Reason for temporary application exception"
                      AutomationProperties.HelpText="Choose why you need temporary access. Profile limits and delays still apply."
                      AutomationProperties.AutomationId="ApplicationExceptionReason"
                      Margin="0,0,0,10" />
            <Button Content="_Request temporary exception"
                    x:Name="RequestExceptionButton"
                    Command="{Binding RequestExceptionCommand}"
                    IsEnabled="{Binding CanRequestException}"
                    AutomationProperties.Name="Request temporary application exception"
                    AutomationProperties.HelpText="Records an exception request. Profile rules set whether and when it takes effect."
                    AutomationProperties.AutomationId="RequestApplicationException"
                    HorizontalAlignment="Left"
                    MinWidth="230"
                    MinHeight="40" />
            <TextBlock Text="{Binding StatusMessage}"
                       AutomationProperties.Name="Overlay status message"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="OverlayStatusMessage"
                       TextWrapping="Wrap"
                       Margin="0,14,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
</Window>
