<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure: EF Core SQLite, file system, clocks, logging adapters,
       backup implementation. Implements Application ports; references Application
       and Domain only (system-architecture.md section 5). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoundlessStudy.Application\BoundlessStudy.Application.csproj" />
    <ProjectReference Include="..\BoundlessStudy.Domain\BoundlessStudy.Domain.csproj" />
  </ItemGroup>

</Project>
