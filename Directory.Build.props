<Project>

  <!-- Central build settings for the Boundless Study solution.
       Approved architecture: docs/04-architecture/system-architecture.md section 4/5. -->

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>0.1.0</Version>
    <Product>Boundless Study</Product>
    <Company>Boundless Study</Company>
    <Authors>Boundless Study</Authors>
  </PropertyGroup>

</Project>
